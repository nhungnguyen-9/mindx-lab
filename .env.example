# =============================================================================
# MindX Lab - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for local development.

# -----------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string from your Neon project dashboard.
# Format: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# Secret key used to sign and verify JWT tokens (HS256).
# Use a random string of at least 32 characters.
JWT_SECRET=

# -----------------------------------------------------------------------------
# Cloudinary (Image uploads)
# -----------------------------------------------------------------------------
# Found in your Cloudinary Dashboard > Account Details.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload preset name (must be configured as unsigned in Cloudinary settings).
CLOUDINARY_UPLOAD_PRESET=

# Folder path where uploaded images are stored in Cloudinary.
CLOUDINARY_UPLOAD_FOLDER=mindx-lab

# -----------------------------------------------------------------------------
# Vercel Blob (Project bundle hosting)
# -----------------------------------------------------------------------------
# Read/write token for the Vercel Blob store that hosts uploaded project
# bundles (web .zip and Scratch .sb3). On Vercel this is injected automatically
# when a Blob store is linked; for local dev, copy it from the Vercel dashboard
# (Storage > your Blob store > .env.local snippet).
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------------
# Admin Seed Credentials
# -----------------------------------------------------------------------------
# Used by `npm run db:seed-admin` to create the initial admin user.
# Change these before running the seed script.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
